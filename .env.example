# Copy to .env (ignored by Git) and fill in locally. Never commit real keys.

# Generation providers (at least one is needed to answer questions; ingestion and
# retrieval work without any key because embeddings run locally).
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# openai | groq | auto (auto = OpenAI first, one visible fallback to Groq)
RAG_PROVIDER=auto
RAG_OPENAI_MODEL=gpt-4.1-mini-2025-04-14
RAG_GROQ_MODEL=openai/gpt-oss-120b

# Retrieval: dense | bm25 | hybrid | hybrid_rerank
# RAG_RETRIEVAL_MODE=dense
# RAG_EVIDENCE_TOKEN_BUDGET=3000
# RAG_CONTEXT_MAX_CHUNKS=6

# Spending guards for `rag evaluate` (stop when either cap is reached)
RAG_EVAL_MAX_REQUESTS=60
RAG_EVAL_MAX_COST_USD=0.50

# Local storage for crawl snapshots, vector store, traces, usage ledger (ignored by Git)
# RAG_DATA_DIR=data
